{
  "name": "ai-code-editor",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "API_KEY": ""
  },
  "routes": [
    { "pattern": "ai-editor.zztxer.dpdns.org", "custom_domain": true }
  ]
}
